# =============================================================================
# HMO Hunter Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Supabase Configuration
# Get these from your Supabase project settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Server-side alias, read by lib/supabase-admin.ts and the export path
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# REQUIRED: Error Monitoring (Sentry)
# Get this from your Sentry project settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# -----------------------------------------------------------------------------
# OPTIONAL: Email Notifications (Resend)
# Required for price alerts and notification features
# Sign up at https://resend.com
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="HMO Hunter <notifications@yourdomain.com>"
CRON_SECRET=your-random-secret-for-cron-jobs

# -----------------------------------------------------------------------------
# OPTIONAL: Google Maps API
# Required for Street View images and geocoding
# Get this from Google Cloud Console
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# OPTIONAL: Property Data Enrichment APIs
# These APIs provide additional property data
# -----------------------------------------------------------------------------

# PropertyData.co.uk - Property valuations and data
PROPERTYDATA_API_KEY=your-propertydata-api-key
PROPERTYDATA_BASE_URL=https://api.propertydata.co.uk

# StreetData.co.uk - Street-level property data
STREETDATA_API_KEY=your-streetdata-api-key
STREETDATA_BASE_URL=https://api.street.co.uk

# PaTMa - Property analysis platform
PATMA_API_KEY=your-patma-api-key
PATMA_BASE_URL=https://app.patma.co.uk/api

# Searchland - Land Registry and EPC data
SEARCHLAND_API_KEY=your-searchland-api-key
SEARCHLAND_BASE_URL=https://api.searchland.co.uk/v1

# EPC Register API (Open Data)
EPC_API_EMAIL=your-email@example.com
EPC_API_KEY=your-epc-api-key

# -----------------------------------------------------------------------------
# OPTIONAL: Additional Enrichment APIs
# -----------------------------------------------------------------------------

# Companies House - Corporate landlord data (UK Gov)
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# Kamma Data - HMO licensing intelligence
KAMMA_API_KEY=your-kamma-api-key
KAMMA_SERVICE_KEY=your-kamma-service-key
KAMMA_GROUP_ID=your-kamma-group-id
KAMMA_BASE_URL=https://apiv3-sandbox.kammadata.com

# Zoopla API - Property listings and images
ZOOPLA_API_KEY=your-zoopla-api-key
ZOOPLA_BASE_URL=https://api.zoopla.co.uk/api/v1

# Apify - Web scraping platform (for Rightmove data)
APIFY_API_TOKEN=your-apify-token

# OFCOM - Broadband coverage data
OFCOM_API_KEY=your-ofcom-api-key

# Land Registry - Title ownership data
LAND_REGISTRY_API_KEY=your-land-registry-api-key

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------

# Use mock data instead of real API calls (development only)
USE_MOCK_DATA=false
MOCK_PROPERTY_COUNT=50

# Playwright test configuration
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000

# ─── Not yet documented above, but read by the code ──────────────────────────
# Every variable below appears in a process.env lookup somewhere in app/, lib/
# or components/. Listed so the gap between "the code expects it" and "it is
# set" is visible in one place rather than discovered at runtime.

# Public URLs. Used for OAuth callbacks, Stripe redirects and server-to-server
# fetches; each currently falls back to a hardcoded default.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SITE_URL=

# Admin endpoints
ADMIN_API_KEY=

# Rate limiting (lib/redis.ts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Image fallbacks behind Zoopla
GOOGLE_MAPS_API_KEY=
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# Direct mail (lib/integrations/stannp.ts)
STANNP_API_KEY=

# Payments. Note the `stripe` package is not installed either, so these routes
# cannot build as things stand.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
